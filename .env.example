# ============================================================
# ДОМАС — переменные окружения
# Скопируй в .env.local и заполни значениями
# ============================================================

# --- База данных PostgreSQL ---
# Формат: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/domas"

# --- NextAuth.js ---
# Генерируй командой: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"
# URL приложения (без слэша в конце)
NEXTAUTH_URL="http://localhost:3000"

# --- ЮKassa (платёжная система) ---
# Получи в личном кабинете ЮKassa: https://yookassa.ru/my/shop-settings/http
YUKASSA_SHOP_ID="your-shop-id"
YUKASSA_SECRET_KEY="your-secret-key"
# URL для webhooks от ЮKassa
YUKASSA_RETURN_URL="http://localhost:3000/dashboard?payment=success"

# --- Email рассылки (UniSender или SendPulse) ---
# UniSender: https://app.unisender.com/ru/settings/api
UNISENDER_API_KEY="your-unisender-api-key"
UNISENDER_LIST_ID="your-list-id"
# Или SendPulse:
SENDPULSE_API_USER_ID=""
SENDPULSE_API_SECRET=""

# --- Telegram-бот поддержки ---
TELEGRAM_BOT_TOKEN="your-bot-token"
TELEGRAM_SUPPORT_CHAT_ID="your-chat-id"

# --- Приложение ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Домас"
# Номер телефона поддержки (отображается в UI)
NEXT_PUBLIC_SUPPORT_PHONE="+7 (495) 000-00-00"
