// Prisma схема — Домас
// Документация: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Роли пользователей ───────────────────────────────────────
enum Role {
  USER
  ADMIN
}

// ─── Типы транзакций ДомоКоин ─────────────────────────────────
enum CoinTransactionType {
  EARNED_ORDER
  EARNED_REVIEW
  EARNED_REFERRAL
  EARNED_WELCOME
  SPENT_DISCOUNT
  EXPIRED
}

// ─── Статусы подписки ─────────────────────────────────────────
enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

// ─── Тарифные планы ───────────────────────────────────────────
enum Plan {
  BASIC    // Базовый — 1490₽/мес
  COMFORT  // Комфорт — 3490₽/мес
  MAX      // Максимум — 5990₽/мес
}

// ─── Статусы заказа ───────────────────────────────────────────
enum OrderStatus {
  NEW         // Новый, ожидает назначения
  IN_PROGRESS // В работе
  DONE        // Выполнен
  CANCELLED   // Отменён
}

// ─── Статусы платежа ──────────────────────────────────────────
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// ─── Пользователь ─────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  name         String
  phone        String?
  role         Role     @default(USER)
  coinBalance  Int      @default(0)
  referralCode String?  @unique
  referredBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses        Address[]
  subscriptions    Subscription[]
  orders           Order[]
  payments         Payment[]
  reviews          Review[]
  activityLogs     ActivityLog[]
  coinTransactions CoinTransaction[]

  @@index([email])
  @@index([role])
  @@index([referralCode])
}

// ─── ДомоКоин транзакции ──────────────────────────────────────
model CoinTransaction {
  id          String              @id @default(cuid())
  userId      String
  amount      Int
  type        CoinTransactionType
  description String
  orderId     String?
  expiresAt   DateTime?
  createdAt   DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([expiresAt])
}

// ─── Адреса пользователя ──────────────────────────────────────
model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String
  address   String
  city      String?
  landmark  String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

// ─── Подписка ─────────────────────────────────────────────────
model Subscription {
  id        String             @id @default(cuid())
  userId    String
  plan      Plan
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime?
  price     Int                // В рублях
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId])
  @@index([status])
}

// ─── Заказ / Визит ────────────────────────────────────────────
model Order {
  id              String      @id @default(cuid())
  userId          String
  addressId       String?
  serviceType     String
  status          OrderStatus @default(NEW)
  scheduledAt     DateTime
  completedAt     DateTime?
  price           Int         @default(0)
  comment         String?
  teamNote        String?
  timeSlot        String?
  isRecurring     Boolean     @default(false)
  recurringType   String?
  specialRequests String?     @db.Text
  promoCode       String?
  paymentMethod   String      @default("cash")
  orderNumber     String?     @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  address  Address?  @relation(fields: [addressId], references: [id])
  payments Payment[]
  review   Review?

  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
}

// ─── Платёж ───────────────────────────────────────────────────
model Payment {
  id             String        @id @default(cuid())
  userId         String
  orderId        String?
  subscriptionId String?
  amount         Int           // В рублях
  status         PaymentStatus @default(PENDING)
  provider       String        @default("yukassa") // yukassa, card и т.д.
  externalId     String?       // ID платежа в ЮKassa
  metadata       Json?         // Дополнительные данные от платёжной системы
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  order        Order?        @relation(fields: [orderId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([externalId])
}

// ─── Отзыв ────────────────────────────────────────────────────
model Review {
  id        String   @id @default(cuid())
  userId    String
  orderId   String   @unique // Один отзыв на один заказ
  rating    Int      // 1–5
  comment   String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orderId])
}

// ─── Настройки сайта (CMS) ────────────────────────────────────
model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// ─── Журнал действий администратора ──────────────────────────
model ActivityLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String   // "UPDATE_SETTING", "UPDATE_ORDER", "SEND_EMAIL", etc.
  target    String?  // ID целевой сущности
  detail    String?  // Человекочитаемое описание
  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([createdAt])
}
